  "scripts": {
    "admin:build": "pnpm run --filter=admin build",
    "admin:check": "pnpm run --filter=admin check",
    "admin:dev": "pnpm run --filter=admin dev",
    "admin:preview": "pnpm run --filter=admin preview",
    "blog:build": "pnpm run --filter=blog build",
    "blog:check": "pnpm run --filter=blog check",
    "blog:dev": "pnpm run --filter=blog dev",
    "blog:preview": "pnpm run --filter=blog preview",
    "cms": "pnpm run --filter=admin dev",
    "cms-both": "concurrently 'pnpm run --filter=admin dev' 'pnpm run --filter=blog preview'",
    "cms-dev-both": "concurrently 'pnpm run --filter=admin dev' 'sleep 1 && pnpm run --filter=blog dev'",
    "prepare": "husky",
    "shared:check": "pnpm run --filter=shared check"
  },
  "lint-staged": {
    "package.json": "sort-package-json"
  },
  "dependencies": {
    "concurrently": "^10.0.4"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "sort-package-json": "^4.0.0"
  },
  "packageManager": "pnpm@11.7.0"
}