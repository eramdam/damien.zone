---
import type { InferEntrySchema } from "astro:content";
import slug from "slug";
import { SITE } from "../helpers/siteConstants";
import PostDate from "./PostDate.astro";

interface Props {
  data: InferEntrySchema<"blog">;
}

const data = Astro.props.data;
const title = data.title;
const hasLinkedUrl = !!data.linkedUrl;
const postUrl = data.linkedUrl
  ? new URL(data.linkedUrl)
  : new URL(data.slug, Astro.site);
---

<div class="h-entry" style="display: contents;">
  <div class="p-author h-card">
    <data class="p-name" value={SITE.author}></data>
    <data class="u-url u-uid" value="/"></data>
    <data class="u-photo" value="/avatar/portrait.webp"></data>
  </div>
  <h1 class="p-name">
    <a
      href={postUrl}
      rel="canonical"
      class="u-url u-uid"
      class:list={["u-url", "u-uid", hasLinkedUrl && "with-link"]}
    >
      {title}
    </a>
  </h1>

  <p class="post-datetime">
    <PostDate
      class="dt-published"
      date={data.date instanceof Date ? data.date : new Date(data.date)}
    />
  </p>

  <div class="e-content">
    <slot />
  </div>
  {
    data.tags && (
      <p class="tags">
        {data.tags.map((t: string) => {
          return <a href={`/tag/${slug(t)}`} class="p-category" set:text={t} />;
        })}
        {(data.mastodonUrl || data.blueskyUrl) && (
          <Fragment>
            •{" "}
            {data.mastodonUrl && (
              <a
                rel="syndication"
                class="u-syndication"
                href={data.mastodonUrl}
              >
                Mastodon
              </a>
            )}
            {data.blueskyUrl && (
              <a rel="syndication" class="u-syndication" href={data.blueskyUrl}>
                Bluesky
              </a>
            )}
          </Fragment>
        )}
      </p>
    )
  }
</div>
