---
import { dateToRfc3339, formatDate } from "@damien.zone/shared/helpers";

interface Props {
  posts: {
    data: {
      date: Date;
      slug: string;
      title: string;
      linkedUrl?: string | undefined;
    };
  }[];
}

const posts = Astro.props.posts;
---

<ul class="blog-posts">
  {
    posts.map((post) => {
      const postDate = post.data.date;
      const hasLinkedUrl = !!post.data.linkedUrl;
      return (
        <li>
          <span>
            <time
              datetime={dateToRfc3339(postDate)}
              title={formatDate(postDate, "iii, MMM d, y, ppp")}
            >
              {formatDate(postDate, "d MMM, yyyy")}
            </time>
          </span>
          <a href={`/${post.data.slug}`}>
            {post.data.title}
            <span class="linked-arrow">{hasLinkedUrl && " →"}</span>
          </a>
        </li>
      );
    })
  }
</ul>
