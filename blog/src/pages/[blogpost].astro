---
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";
import BlogPost from "../components/BlogPost.astro";
import { getBlogPosts } from "../helpers/postsHelpers";
import { truncateText } from "../helpers/textHelpers";
import BaseLayout from "../layouts/BaseLayout.astro";

function markdownToPlainText(md: string): string {
  return md
    .replace(/^---[\s\S]*?---\n*/m, "")
    .replace(/!\[.*?\]\(.*?\)/g, "")
    .replace(/\[([^\]]+)\]\(.*?\)/g, "$1")
    .replace(/<[^>]+>/g, "")
    .replace(/[#*_~`>|]/g, "")
    .replace(/\n+/g, " ")
    .trim();
}

export const getStaticPaths = (async () => {
  const posts = await getBlogPosts();
  return posts.map((post) => {
    return {
      props: { post },
      params: {
        blogpost: post.data.slug,
      },
    };
  });
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(post);
const data = { ...post.data, ...remarkPluginFrontmatter };
if (!data.description && post.body) {
  data.description = truncateText(markdownToPlainText(post.body), 10);
}
---

<BaseLayout frontmatter={data} content={data} isPost>
  <BlogPost data={data}>
    <Content />
  </BlogPost>
</BaseLayout>
