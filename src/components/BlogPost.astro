---
import slug from "slug";
import { SITE } from "../helpers/siteConstants";
import { type PostContentProps } from "../helpers/siteHelpers";
import PostDate from "./PostDate.astro";

interface Props {
  data: Record<string, any>;
}

const data = Astro.props.data as PostContentProps & Record<string, any>;
const title = data.title;
const postUrl = new URL(data.slug, Astro.site);
---

<div class="p-author h-card">
  <data class="p-name" value={SITE.author}></data>
  <data class="u-url u-uid" value="/"></data>
  <data class="u-photo" value="/avatar/portrait.webp"></data>
</div>
<h1 class="p-name">
  <a href={postUrl} rel="canonical" class="u-url u-uid"> {title} </a>
</h1>

<p class="post-datetime">
  <PostDate class="dt-published" date={data.date instanceof Date ? data.date : new Date(data.date)} />
</p>

<div class="e-content">
  <slot />
</div>
{
  data.tags && (
    <p class="tags">
      {data.tags.map((t: string) => {
        return <a href={`/tag/${slug(t)}`} class="p-category" set:text={t} />;
      })}
    </p>
  )
}
