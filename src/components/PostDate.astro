---
import { dateToRfc3339, formatDate } from "../helpers/componentHelpers";

interface Props {
  date: Date;
  updated?: Date;
  class?: string;
}

const { updated, date } = Astro.props;
---

<time
  datetime={dateToRfc3339(date)}
  title={formatDate(date, "iii, MMM d, y, ppp")}
  class:list={Astro.props.class}
>
  {formatDate(date, "PPP")}
</time>
{updated && <time datetime={dateToRfc3339(updated)} class="dt-updated" />}
