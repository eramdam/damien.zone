---
import PostsList from "./PostsList.astro";

const posts = Object.values(
  import.meta.glob("../blog/**/*.md", { eager: true })
).toSorted((a, b) => {
  return (
    // @ts-expect-error
    new Date(b.frontmatter.date).valueOf() -
    // @ts-expect-error
    new Date(a.frontmatter.date).valueOf()
  );
});
---

<PostsList
  posts={(
    posts as {
      frontmatter: Record<string, string>;
      compiledContent: any;
    }[]
  ).slice(0, 5)}
/>
