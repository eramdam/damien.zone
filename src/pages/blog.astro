---
import { getCollection } from "astro:content";
import { groupBy } from "es-toolkit";

import { sortPosts } from "../helpers/siteHelpers";
import BaseLayout from "../layouts/BaseLayout.astro";
import PostsList from "../components/PostsList.astro";
const basePosts = sortPosts(await getCollection("blog"));
const postsByYear = groupBy(basePosts, (p) => {
  return p.data.date.getUTCFullYear();
});
---

<BaseLayout
  content={{
    title: "Blog",
    description:
      "french software engineer living and working in the Bay Area on web stuff",
  }}
  frontmatter={{
    class_name: "blog-feed",
  }}
>
  <h1>Blog</h1>

  {
    Object.keys(postsByYear)
      .toReversed()
      .map((k) => {
        return (
          <>
            <h3>
              {k}
              <hr />
            </h3>
            <PostsList posts={postsByYear[k]} />
          </>
        );
      })
  }
</BaseLayout>
