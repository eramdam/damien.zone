---
import BlogPost from "../../components/BlogPost.astro";
import { sortPosts } from "../../helpers/siteHelpers";
import Base from "../../layouts/base.astro";
const posts = sortPosts(
  Object.values(import.meta.glob("../../blog/**/*.md", { eager: true }))
);
const firstPage = posts.slice(0, 5);
const numberOfPages = Math.ceil(posts.length / 5);
---

<Base
  content={{
    title: "Blog",
    description:
      "french software engineer living and working in the Bay Area on web stuff",
  }}
>
  {
    firstPage.map((post) => {
      return (
        <article class="main-block h-entry">
          <BlogPost postProps={post} inFeed />
        </article>
      );
    })
  }
  <nav class="main-block pagination">
    Page 1 out of {numberOfPages}
    <a href={`/blog/page/2`} rel="next"> &RightArrow; </a>
  </nav>
</Base>
