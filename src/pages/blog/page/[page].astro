---
import type { GetStaticPaths } from "astro";
import Base from "../../../layouts/base.astro";
import BlogPost from "../../../components/BlogPost.astro";
export const getStaticPaths = (({ paginate }) => {
  const posts = Object.values(
    import.meta.glob("../../../blog/**/*.md", { eager: true })
  );
  return paginate(
    posts.toSorted((a, b) => {
      return (
        // @ts-expect-error
        new Date(b.frontmatter.date).valueOf() -
        // @ts-expect-error
        new Date(a.frontmatter.date).valueOf()
      );
    }),
    {
      pageSize: 5,
    }
  );
}) satisfies GetStaticPaths;

// console.log(Astro.props.page);
const page = Astro.props.page;
const posts = Array.from(page.data);
---

<Base
  content={{
    title: "Blog",
    description:
      "french software engineer living and working in the Bay Area on web stuff",
  }}
>
  {
    posts.map((post) => {
      return (
        <article class="main-block h-entry">
          <BlogPost postProps={post} inFeed />
        </article>
      );
    })
  }
  <nav class="main-block pagination">
    {
      page.url.prev && (
        <a href={page.url.prev} rel="prev">
          &LeftArrow;
        </a>
      )
    }
    Page {page.currentPage} out of {page.lastPage}
    {
      page.url.next && (
        <a href={page.url.next} rel="next">
          &RightArrow;
        </a>
      )
    }
  </nav>
</Base>
