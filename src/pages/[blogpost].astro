---
import type { GetStaticPaths } from "astro";
import assert from "node:assert";
import PostLayout from "../layouts/PostLayout.redesign.astro";
import BaseLayout from "../layouts/BaseLayout.redesign.astro";
import BlogPost from "../components/BlogPost.astro";

export const getStaticPaths = (() => {
  const posts = Object.values(
    import.meta.glob("../blog/**/*.md", { eager: true }),
  );
  return posts.map((post: any) => {
    assert(post.frontmatter.slug);

    return {
      props: { post },
      params: {
        blogpost: post.frontmatter.slug,
      },
    };
  });
}) satisfies GetStaticPaths;
---

<BaseLayout {...Astro.props.post}>
  <BlogPost postProps={Astro.props.post} />
</BaseLayout>
