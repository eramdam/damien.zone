---
import { uniq } from "lodash-es";
import slug from "slug";
import Base from "../layouts/base.astro";
const posts = Object.values(
  import.meta.glob("../blog/**/*.md", { eager: true })
);

const tags = uniq(
  posts.flatMap((p: any) => {
    return p.frontmatter.tags;
  })
).toSorted();
---

<Base content={{ description: "List of tags" }}>
  <h1>tags</h1>

  <ul class="tags-list">
    {
      tags.map((tag) => {
        return (
          <li>
            <a href={`/tag/${slug(tag)}`}>#{tag}</a>
          </li>
        );
      })
    }
  </ul>
</Base>
