---
import { uniq } from "es-toolkit";
import slug from "slug";
import { getBlogPosts } from "../helpers/postsHelpers";
import BaseLayout from "../layouts/BaseLayout.astro";
const posts = await getBlogPosts();

const tags = uniq(
  posts.flatMap((p) => {
    return p.data.tags;
  }),
).toSorted();
---

<BaseLayout content={{ description: "List of tags" }}>
  <h1>tags</h1>

  <ul class="tags-list">
    {
      tags.map((tag) => {
        return (
          <li>
            <a href={`/tag/${slug(tag)}`}>#{tag}</a>
          </li>
        );
      })
    }
  </ul>
</BaseLayout>
