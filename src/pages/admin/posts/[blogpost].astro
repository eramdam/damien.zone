---
import { getBlogPosts } from "../../../helpers/postsHelpers";
import BaseAdmin from "../../../layouts/admin/BaseAdmin.astro";
export const prerender = false;

const posts = await getBlogPosts();
const { blogpost } = Astro.params;
const post = posts.find((p) => p.data.slug === blogpost);

if (!post) {
  return Astro.redirect("/404");
}
---

<script define:vars={{ post }}>
  window.initData = post;
</script>
<script src="./post-edit.ts"></script>
<BaseAdmin class="post-edit" title=`Editing ${post.data.title}`>
  <form>
    <nav>
      <button type="button" class="back-button">← Back</button>
      <button type="submit">Save</button>
      <button type="button" class="view-button">View</button>
    </nav>
    <input type="hidden" id="slug" name="slug" value={blogpost} />
    <input type="hidden" name="filePath" value={post.filePath} />
    <div id="post-edit-area"></div>
  </form>
</BaseAdmin>
