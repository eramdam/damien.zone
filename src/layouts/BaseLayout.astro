---
import Body from "../components/Body.astro";
import CommonIncludes from "../components/CommonIncludes.astro";
import Footer from "../components/Footer.astro";
import Head from "../components/Head.astro";
import Navigation from "../components/Navigation.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <Head {...Astro.props} />
    <CommonIncludes />
  </head>

  <Body class:list={Astro.props.frontmatter?.class_name}>
    <Navigation />
    <main>
      <slot />
    </main>
    <Footer />
  </Body>
</html>
