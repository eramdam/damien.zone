---
import Body from "../components/Body.astro";
import CommonIncludes from "../components/CommonIncludes.redesign.astro";
import Footer from "../components/Footer.redesign.astro";
import Head from "../components/Head.astro";
import Navigation from "../components/Navigation.redesign.astro";
import SvgSpritesheet from "../components/svgSpritesheet.astro";

interface Props {
  isPost?: boolean;
  content?: {
    title?: string;
    description: string;
  };
  frontmatter?: Record<string, any>;
}
---

<!doctype html>
<html lang="en">
  <head>
    <Head {...Astro.props} />
    <CommonIncludes />
  </head>
  <!-- @ts-expect-error -->
  <Body
    class:list={[Astro.props.frontmatter?.class_name, "damien-redesign"]}
    isPost={Astro.props.isPost}
  >
    <SvgSpritesheet />
    <Navigation />
    <main>
      <slot />
    </main>

    <Footer />
  </Body>
</html>
