---
import { kebabCase } from "es-toolkit";
import "../../pages/admin/admin.css";
import AdminNav from "../../components/admin/adminNav.astro";

interface Props {
  title: string;
  class?: string;
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>damien.zone - {Astro.props.title}</title>
  </head>
  <body class:list={[Astro.props.class]}>
    <main>
      <AdminNav />
      <slot />
    </main>
  </body>
</html>
