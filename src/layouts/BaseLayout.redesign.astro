---
import Body from "../components/Body.astro";
import CommonIncludes from "../components/CommonIncludes.redesign.astro";
import Head from "../components/Head.astro";
import Navigation from "../components/Navigation.redesign.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <CommonIncludes />
    <Head {...Astro.props} />
  </head>
  <Body class:list={Astro.props.frontmatter?.class_name}>
    <Navigation />
    <main>
      <slot />
    </main>

    <script src="../assets/main.mjs"></script>
  </Body>
</html>
