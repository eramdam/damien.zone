---
export const prerender = false;

import { type InferEntrySchema } from "astro:content";
import fs from "fs";
import matter from "gray-matter";
import { blogCollectionBase, blogSchema } from "../../../../src/content.config";
import PostEdit from "../../layouts/PostEdit.astro";

const postsRaw = fs.globSync(`${blogCollectionBase}/**/*.md`);
const posts: {
  id: string;
  body?: string;
  collection: "blog";
  data: InferEntrySchema<"blog">;
  filePath: string;
}[] = postsRaw.map((raw) => {
  const data = matter(fs.readFileSync(raw, "utf-8"), {});
  return {
    id: Date.now().toString(16),
    body: data.content,
    collection: "blog",
    data: blogSchema.parse(data.data),
    filePath: raw,
  };
});

const { blogpost } = Astro.params;
const post = posts.find((p) => p.data.slug === blogpost);

if (!post) {
  return Astro.redirect("/404");
}
---

<PostEdit post={post} />
