---
export const prerender = false;

import { z } from "astro/zod";
import { getCollection } from "astro:content";
import type { MonacoTheme } from "monaco-themes";
import { createRequire } from "node:module";
import type { blogSchema } from "../../../../src/content.config";
import BaseAdmin from "../../layouts/BaseAdmin.astro";

const require = createRequire(import.meta.url);
const posts = await getCollection("blog");
const blogSchemeDescription: Record<keyof z.infer<typeof blogSchema>, string> =
  {
    title: "My post",
    slug: "my-post",
    class_name: "",
    date: new Date().toISOString(),
    description: "",
    image: "https://crouton.net/crouton.png",
    isDraft: "false",
    layout: "../layouts/BaseLayout.astro",
    linkedUrl: "",
    tags: [].join(", "),
    updated: new Date().toISOString(),
  };

const loadTheme = async (themeName: string) => {
  const base = require(`../../../themes/${themeName}.json`) as MonacoTheme;

  base.colors = {};
  base.rules = [
    ...base.rules,
    {
      token: "type",
      fontStyle: "bold",
    },
  ];

  return base;
};

const darkTheme = await loadTheme("GitHub Dark");
const lightTheme = await loadTheme("GitHub");

const { blogpost } = Astro.params;
const post = posts.find((p) => p.data.slug === blogpost);

if (!post) {
  return Astro.redirect("/404");
}
---

<script define:vars={{ post, darkTheme, lightTheme }}>
  window.initData = post;
  window.darkTheme = darkTheme;
  window.lightTheme = lightTheme;
</script>
<script src="../../scripts/post-edit.ts"></script>
<BaseAdmin class="post-edit" title=`Editing ${post.data.title}`>
  <form>
    <nav>
      <button type="button" class="back-button">← Back</button>
      <button type="submit">Save</button>
      <button type="button" class="publish-button">Publish</button>
      <button type="button" class="view-button">View</button>
      <button type="button" class="unpublish-button danger">Unpublish</button>
    </nav>
    <details>
      <summary>Attributes</summary>
      <p>
        {
          Object.entries(blogSchemeDescription).map((pair) => (
            <Fragment>
              {pair[0]}: {pair[1]} <br />
            </Fragment>
          ))
        }
      </p>
    </details>
    <input type="hidden" id="slug" name="slug" value={blogpost} />
    <input type="hidden" name="filePath" value={post.filePath} />
    <div id="attrs-edit-area"></div>
    <div id="post-edit-area"></div>
  </form>
</BaseAdmin>
