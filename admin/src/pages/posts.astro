---
import {
  dateToRfc3339,
  formatDate,
  sortPosts,
} from "@damien.zone/shared/helpers";
import { getAllPostsFromDisk } from "../contentHelpers";
import BaseAdmin from "../layouts/BaseAdmin.astro";
const posts = sortPosts(await getAllPostsFromDisk());
---

<BaseAdmin title="Posts">
  <h1>Posts</h1>
  <nav>
    <button onclick="window.location = '/posts/new';">New post</button>
  </nav>
  <ul class="posts-list">
    {
      posts.map((post) => {
        const postDate = post.data.date;
        return (
          <li>
            <time
              datetime={dateToRfc3339(postDate)}
              title={formatDate(postDate, "iii, MMM d, y, ppp")}
            >
              {formatDate(postDate, "dd MMM, yyyy")}
            </time>
            <a href={`/posts/${post.data.slug}`}>{post.data.title}</a>
            {post.data.isDraft && <small>(not published)</small>}
          </li>
        );
      })
    }
  </ul>
</BaseAdmin>
