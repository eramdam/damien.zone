---
import {
  dateToRfc3339,
  formatDate,
} from "../../../src/helpers/componentHelpers";
import { getBlogPosts } from "../../../src/helpers/postsHelpers";
import { sortPosts } from "../../../src/helpers/siteHelpers";
import BaseAdmin from "../layouts/BaseAdmin.astro";
const posts = sortPosts(await getBlogPosts());
---

<BaseAdmin title="Posts">
  <h1>Posts</h1>
  <ul class="posts-list">
    {
      posts.map((post) => {
        const postDate = post.data.date;
        return (
          <li>
            <time
              datetime={dateToRfc3339(postDate)}
              title={formatDate(postDate, "iii, MMM d, y, ppp")}
            >
              {formatDate(postDate, "dd MMM, yyyy")}
            </time>
            <a href={`/posts/${post.data.slug}`}>
              {post.data.title}
              {post.data.title}
            </a>
          </li>
        );
      })
    }
  </ul>
</BaseAdmin>
